# ---- Application ----
# ./artisan dev uses Vite HMR; production needs APP_KEY (./artisan key:generate)
APP_ENV=development
APP_ADDR=127.0.0.1:8080
APP_URL=http://127.0.0.1:8080
APP_KEY=
SITE_NAME=Awesome Open Source

# ---- Locales (each needs app/i18n/locales/<code>.json) ----
DEFAULT_LOCALE=en
LOCALES=en,ro,es,fr,de

# ---- docker compose (postgres + typesense) ----
DATABASE_URL=postgres://aos:aos@127.0.0.1:5432/aos?sslmode=disable
TYPESENSE_URL=http://127.0.0.1:8108
TYPESENSE_API_KEY=aos-dev-typesense-key

# ---- Admin panel (/admin). The account is created/updated at startup. ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
UPLOAD_DIR=data/uploads

# ---- GitHub (a token enables GraphQL: all branches + higher rate limits) ----
GITHUB_TOKEN=
# Background refresh of project scores; 0 disables (use `go run . sync` instead)
SYNC_INTERVAL_MINUTES=0
SYNC_BATCH_SIZE=50
SYNC_STALE_HOURS=24

# ---- AI translation of project texts (optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Embeddings for "similar projects" via pgvector (optional, OpenAI-compatible) ----
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
